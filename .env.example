# GridWise Service Configuration
# Copy this file to .env and configure provider credentials as needed.

# Service networking
HOST=0.0.0.0
PORT=8000

# LLM Provider selection: "gemini", "openai", or "fake" (for offline testing)
LLM_PROVIDER=gemini

# Google Gemini Settings (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / Compatible Settings (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Timeouts & Budgets (in seconds)
REQUEST_TIMEOUT_SECONDS=28.0
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=1
SOLVER_TIMEOUT_SECONDS=5.0

# Logging Level
LOG_LEVEL=INFO
